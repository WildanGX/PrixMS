# ==========================================
# RUST & CARGO
# ==========================================
# Folder hasil kompilasi binary (ukurannya bisa ber-GB-GB, wajib ignore)
/target/

# Cargo lockfile internal development jika library (opsional, tapi untuk aplikasi/binary aman di-commit)
# Kita simpan Cargo.lock biar versi dependency terkunci rapat.

# Backup file dari Cargo/rustfmt
**/*.rs.bk
*.bk

# ==========================================
# MINECRAFT SERVER RUNTIME & DATA
# ==========================================
# Data dunia Minecraft, region Anvil, & playerdata (biar repo gak berat)
/world/
/world_nether/
/world_the_end/
*.mca
*.dat

# File runtime server & log
/logs/
/crash-reports/
*.log

# Cache & temporary files
/cache/
/.prixms/

